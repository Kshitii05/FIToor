# Copy to .env (same folder) and adjust. Never commit .env.

# Product name. The only place the name is defined; server and client both read it.
APP_NAME=Marketplace

NODE_ENV=development

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Docker host ports (5433 avoids clashing with a locally installed PostgreSQL)
POSTGRES_PORT=5433
REDIS_PORT=6379

# Databases: development and a separate one used only by the test suite
DATABASE_URL=postgresql://app:app@localhost:5433/marketplace?schema=public
DATABASE_URL_TEST=postgresql://app:app@localhost:5433/marketplace_test?schema=public

REDIS_URL=redis://localhost:6379

# Secrets (at least 32 characters each). Generate real ones for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000000000
OTP_SECRET=dev-only-otp-secret-change-me-0000000000000000

# Email. Leave SMTP_HOST unset in development: emails are then printed to the server console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=no-reply@localhost
