# Copy to .env (same folder) and adjust. Never commit .env.

# Product name. The only place the name is written; server and client both read it from here.
APP_NAME=FIToor
# Short line shown next to the name. Optional.
APP_TAGLINE=Fashion ka fitoor

NODE_ENV=development

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Databases: development and a separate one used only by the test suite.
#
# Default: services installed on this machine. PostgreSQL with the PostGIS extension,
# and a Redis-compatible server (on Windows: Memurai). The databases are created by
# the first migration. The PostgreSQL user must be a superuser, because the migrations
# install extensions. Characters such as @ : / # in the password must be URL-encoded.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/marketplace?schema=public
DATABASE_URL_TEST=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/marketplace_test?schema=public
REDIS_URL=redis://localhost:6380

# Secrets (at least 32 characters each). Generate real ones for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000000000
OTP_SECRET=dev-only-otp-secret-change-me-0000000000000000

# Email. Leave SMTP_HOST unset in development: emails are then printed to the server console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=no-reply@localhost

# Image uploads. Leave unset in development: photos are then kept in server/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Place search uses OpenStreetMap (Nominatim). Its policy asks for a contact address
# (email or website) in every request; set one before real use.
# GEOCODER_CONTACT=

# Razorpay, test mode only (keys start with rzp_test_). Leave unset in development to use a
# simulated payment instead. Live keys are refused.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Demo data (development only): `npm run seed --workspace server` creates demo sellers and
# about 200 listings. Set this to be able to sign in as the demo accounts.
# SEED_USER_PASSWORD=
