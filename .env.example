# Copy to .env (same folder) and adjust. Never commit .env.

# Product name. The only place the name is defined; server and client both read it.
APP_NAME=Marketplace

NODE_ENV=development

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Docker host ports (5433 avoids clashing with a locally installed PostgreSQL)
POSTGRES_PORT=5433
REDIS_PORT=6379

# Databases: development and a separate one used only by the test suite
DATABASE_URL=postgresql://app:app@localhost:5433/marketplace?schema=public
DATABASE_URL_TEST=postgresql://app:app@localhost:5433/marketplace_test?schema=public

REDIS_URL=redis://localhost:6379
