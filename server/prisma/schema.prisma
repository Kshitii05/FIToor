generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models are added per module. PostGIS columns use Unsupported("geography(Point,4326)")
// with GiST indexes and exclusion constraints written in raw SQL migrations.

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  VERIFY
  PASSWORD_RESET
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  // Stored lower-cased; a CHECK constraint in the migration enforces it.
  email                String     @unique
  // E.164. Null only after the account has been erased.
  phone                String?    @unique
  passwordHash         String     @map("password_hash")
  emailVerifiedAt      DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt      DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  status               UserStatus @default(ACTIVE)
  role                 UserRole   @default(USER)
  deletionRequestedAt  DateTime?  @map("deletion_requested_at") @db.Timestamptz(3)
  deletionScheduledFor DateTime?  @map("deletion_scheduled_for") @db.Timestamptz(3)
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                 UserProfile?
  verifications           UserVerification[]
  sessions                UserSession[]
  listings                Listing[]
  listingEvents           ListingStatusEvent[]
  likes                   ListingLike[]
  views                   ListingView[]
  searches                SearchHistory[]
  locations               SavedLocation[]
  cartItems               CartItem[]
  addresses               Address[]
  checkouts               Checkout[]
  sellerGroups            CheckoutGroup[]           @relation("CheckoutGroupSeller")
  purchases               Order[]                   @relation("OrderBuyer")
  sales                   Order[]                   @relation("OrderSeller")
  orderEvents             OrderEvent[]
  adminActions            AdminAuditLog[]
  rentals                 RentalBooking[]           @relation("BookingRenter")
  rentedOut               RentalBooking[]           @relation("BookingOwner")
  bookingEvents           BookingEvent[]
  chatsAsA                Conversation[]            @relation("ConversationUserA")
  chatsAsB                Conversation[]            @relation("ConversationUserB")
  chatSeats               ConversationParticipant[]
  sentMessages            Message[]
  offersMade              PriceOffer[]              @relation("OfferBuyer")
  offersGot               PriceOffer[]              @relation("OfferSeller")
  blocking                BlockedUser[]             @relation("Blocker")
  blockedBy               BlockedUser[]             @relation("Blocked")
  claimsMade              Dispute[]                 @relation("DisputeClaimant")
  claimsAgainst           Dispute[]                 @relation("DisputeRespondent")
  evidence                DisputeEvidence[]
  reviewsGiven            Review[]                  @relation("ReviewAuthor")
  reviewsGot              Review[]                  @relation("ReviewSubject")
  reports                 Report[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([status, deletionScheduledFor])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  bio         String?
  photoUrl    String?  @map("photo_url")
  // Free-text area name shown publicly. Never an address.
  locality    String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// One row per one-time code sent. Only the newest row for a user, channel and
// purpose can be redeemed; the rows also drive resend throttling.
model UserVerification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  channel    VerificationChannel
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  attempts   Int                 @default(0)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, purpose, createdAt])
  @@map("user_verifications")
}

// One row per signed-in device. The refresh token rotates in place; the previous
// token's hash is kept so that replaying it revokes the session.
model UserSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  createdAt                DateTime  @map("created_at") @db.Timestamptz(3)
  lastRotatedAt            DateTime? @map("last_rotated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum ListingMode {
  SALE
  RENT
}

enum ListingStatus {
  ACTIVE
  PAUSED
  UNDER_REVIEW
  REMOVED
}

enum ListingCategory {
  ETHNIC_WEAR
  WESTERN_WEAR
  FOOTWEAR
  ACCESSORIES
  BAGS
  FORMAL_WEAR
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
}

// A listing is for sale or for rent, never both. CHECK constraints in the
// migration tie the sale fields and the rent fields to the mode. Amounts are paise.
model Listing {
  id          String          @id @default(uuid()) @db.Uuid
  sellerId    String          @map("seller_id") @db.Uuid
  mode        ListingMode
  status      ListingStatus   @default(ACTIVE)
  title       String
  description String
  category    ListingCategory
  condition   ItemCondition
  brand       String
  size        String
  colour      String

  // Sale only
  pricePaise Int? @map("price_paise")
  quantity   Int?

  // Rent only
  depositPaise       Int? @map("deposit_paise")
  lateFeePerDayPaise Int? @map("late_fee_per_day_paise")

  // Fulfilment: delivery, pickup or both
  offersDelivery      Boolean @map("offers_delivery")
  deliveryChargePaise Int?    @map("delivery_charge_paise")
  deliveryRadiusKm    Int?    @map("delivery_radius_km")
  offersPickup        Boolean @map("offers_pickup")

  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Soft delete: the row stays so orders and bookings can still refer to it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Discovery. Kept on the row so sorting and filtering need no joins.
  // The sale price, or the price of the cheapest rental package.
  headlinePricePaise Int                      @map("headline_price_paise")
  viewCount          Int                      @default(0) @map("view_count")
  likeCount          Int                      @default(0) @map("like_count")
  // Views plus weighted likes; see POPULARITY_LIKE_WEIGHT.
  popularityScore    Int                      @default(0) @map("popularity_score")
  // Filled by a database trigger from title, brand, colour, category and description.
  searchVector       Unsupported("tsvector")? @map("search_vector")

  // Location. The pin is where the seller put it: private, shown only to the seller.
  // The public point is the centre of the ~500 m grid square the pin falls in; it is
  // all anyone else ever sees, and all distances are measured from it.
  pinLat         Float?                                @map("pin_lat")
  pinLng         Float?                                @map("pin_lng")
  publicLat      Float?                                @map("public_lat")
  publicLng      Float?                                @map("public_lng")
  // Area name shown with the listing, such as "Indiranagar".
  locality       String?
  // Kept equal to publicLat/publicLng by a database trigger, for radius search.
  publicLocation Unsupported("geography(Point,4326)")? @map("public_location")

  seller        User                 @relation(fields: [sellerId], references: [id])
  packages      RentalPackage[]
  images        ListingImage[]
  statusEvents  ListingStatusEvent[]
  likes         ListingLike[]
  views         ListingView[]
  cartItems     CartItem[]
  checkoutItems CheckoutItem[]
  orderItems    OrderItem[]
  bookings      RentalBooking[]
  dateHolds     RentalDateHold[]
  blockedDates  RentalBlockedDate[]
  offers        PriceOffer[]

  // Target of the rental package foreign key, which carries the mode.
  @@unique([id, mode])
  @@index([sellerId, deletedAt, status])
  // Search and browse
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_title_trgm_idx")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_brand_trgm_idx")
  @@index([status, createdAt(sort: Desc)])
  @@index([status, headlinePricePaise])
  @@index([status, popularityScore(sort: Desc)])
  @@index([status, category])
  @@index([publicLocation], type: Gist)
  @@map("listings")
}

// Owner-defined rental package: a duration and its price. The foreign key includes
// the mode, fixed to RENT by a CHECK, so a sale listing cannot have packages.
model RentalPackage {
  id           String      @id @default(uuid()) @db.Uuid
  listingId    String      @map("listing_id") @db.Uuid
  listingMode  ListingMode @default(RENT) @map("listing_mode")
  durationDays Int         @map("duration_days")
  pricePaise   Int         @map("price_paise")

  listing Listing @relation(fields: [listingId, listingMode], references: [id, mode], onDelete: Cascade)

  @@unique([listingId, durationDays])
  @@map("rental_packages")
}

// Positions 0 to 7, unique per listing: at most 8 images, enforced by the database.
model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  url       String
  // Identifier in the image store, needed to delete the file.
  storageId String   @map("storage_id")
  position  Int
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@map("listing_images")
}

// Append-only history of what happened to a listing and who did it.
model ListingStatusEvent {
  id          String         @id @default(uuid()) @db.Uuid
  listingId   String         @map("listing_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String
  fromStatus  ListingStatus? @map("from_status")
  toStatus    ListingStatus? @map("to_status")
  reason      String?
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id])
  actor   User?   @relation(fields: [actorUserId], references: [id])

  @@index([listingId, createdAt])
  @@map("listing_status_events")
}

// ---------------------------------------------------------------------------
// Discovery
// ---------------------------------------------------------------------------

model ListingLike {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@map("listing_likes")
}

// One row per user, listing and calendar day (business time zone): a "unique view".
model ListingView {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  viewedOn  DateTime @map("viewed_on") @db.Date

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId, viewedOn])
  @@index([listingId, viewedOn])
  @@map("listing_views")
}

// A user's recent searches, offered back as suggestions. One row per distinct query.
model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  query     String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, createdAt])
  @@map("search_history")
}

// A place a user saved (Home, Work...) to search around. Private to its owner.
model SavedLocation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  locality  String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_locations")
}

// ---------------------------------------------------------------------------
// Cart, checkout and orders
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum Fulfilment {
  DELIVERY
  PICKUP
}

enum CheckoutStatus {
  OPEN
  PAID
  EXPIRED
}

enum OrderStatus {
  AWAITING_DISPATCH
  AWAITING_PICKUP
  DISPATCHED
  DELIVERY_REPORTED
  ADMIN_REVIEW
  DELIVERED
  ISSUE_OPEN
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExtensionStatus {
  NONE
  REQUESTED
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  CAPTURED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundReason {
  BUYER_CANCELLED
  SELLER_CANCELLED
  ADMIN_CANCELLED
  NOT_DELIVERED
  ISSUE_FULL
  ISSUE_PARTIAL
  LATE_PAYMENT
  DUPLICATE_PAYMENT
  RENTER_CANCELLED
  OWNER_CANCELLED
  DEPOSIT_RETURN
}

enum IssueKind {
  WRONG_ITEM
  DAMAGED
  NOT_AS_DESCRIBED
}

enum LedgerEntryType {
  BUYER_PAYMENT
  COMMISSION
  SELLER_PAYABLE
  GATEWAY_FEE
  BUYER_REFUND
  COMMISSION_REVERSAL
  SELLER_PAYABLE_REVERSAL
  // Rentals: the deposit is its own money, never revenue. Collected = refunded + deducted.
  DEPOSIT_COLLECTED
  DEPOSIT_REFUND
  DEPOSIT_DEDUCTION
}

model CartItem {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @map("added_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("cart_items")
}

// A delivery address. Private: shown only to its owner, and to the seller of a paid
// order (as a copy kept on the order).
model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  locality      String
  city          String
  state         String
  pincode       String
  lat           Float
  lng           Float
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("addresses")
}

// A buyer's purchase of everything in their cart. Stock is reserved while OPEN.
// Paying it creates one order per seller.
model Checkout {
  id             String         @id @default(uuid()) @db.Uuid
  buyerId        String         @map("buyer_id") @db.Uuid
  status         CheckoutStatus @default(OPEN)
  totalPaise     Int            @map("total_paise")
  gatewayOrderId String?        @unique @map("gateway_order_id")
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime       @map("created_at") @db.Timestamptz(3)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz(3)
  // Set when the reserved stock went back to the listings (expiry, or replaced).
  releasedAt     DateTime?      @map("released_at") @db.Timestamptz(3)

  buyer    User            @relation(fields: [buyerId], references: [id])
  groups   CheckoutGroup[]
  items    CheckoutItem[]
  payments Payment[]
  orders   Order[]
  refunds  Refund[]

  @@index([buyerId, status])
  @@index([status, expiresAt])
  @@map("checkouts")
}

// One seller's part of a checkout, with how it will be handed over.
model CheckoutGroup {
  id                  String     @id @default(uuid()) @db.Uuid
  checkoutId          String     @map("checkout_id") @db.Uuid
  sellerId            String     @map("seller_id") @db.Uuid
  fulfilment          Fulfilment
  itemsSubtotalPaise  Int        @map("items_subtotal_paise")
  deliveryChargePaise Int        @map("delivery_charge_paise")
  // Copy of the delivery address at the time of checkout.
  deliveryAddress     Json?      @map("delivery_address")

  checkout Checkout       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  seller   User           @relation("CheckoutGroupSeller", fields: [sellerId], references: [id])
  items    CheckoutItem[]

  @@unique([checkoutId, sellerId])
  @@map("checkout_groups")
}

model CheckoutItem {
  id             String  @id @default(uuid()) @db.Uuid
  checkoutId     String  @map("checkout_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  listingId      String  @map("listing_id") @db.Uuid
  quantity       Int
  unitPricePaise Int     @map("unit_price_paise")
  title          String
  // The accepted offer whose price this item uses, if any (I74).
  offerId        String? @map("offer_id") @db.Uuid

  checkout Checkout      @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  group    CheckoutGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  listing  Listing       @relation(fields: [listingId], references: [id])
  offer    PriceOffer?   @relation(fields: [offerId], references: [id])

  @@map("checkout_items")
}

// One seller's order. Each change of status is validated by the server and
// recorded in OrderEvent. Amounts are paise.
model Order {
  id                  String          @id @default(uuid()) @db.Uuid
  ref                 String          @unique
  checkoutId          String          @map("checkout_id") @db.Uuid
  buyerId             String          @map("buyer_id") @db.Uuid
  sellerId            String          @map("seller_id") @db.Uuid
  status              OrderStatus
  fulfilment          Fulfilment
  itemsSubtotalPaise  Int             @map("items_subtotal_paise")
  deliveryChargePaise Int             @map("delivery_charge_paise")
  totalPaise          Int             @map("total_paise")
  commissionPaise     Int             @map("commission_paise")
  sellerPayablePaise  Int             @map("seller_payable_paise")
  // Running totals of processed refunds, all of it and the part that was for items.
  refundedPaise       Int             @default(0) @map("refunded_paise")
  itemsRefundedPaise  Int             @default(0) @map("items_refunded_paise")
  deliveryAddress     Json?           @map("delivery_address")
  handoverCode        String?         @map("handover_code")
  handoverAttempts    Int             @default(0) @map("handover_attempts")
  courierReference    String?         @map("courier_reference")
  dispatchDueAt       DateTime?       @map("dispatch_due_at") @db.Timestamptz(3)
  dispatchWarnedAt    DateTime?       @map("dispatch_warned_at") @db.Timestamptz(3)
  dispatchOverdueAt   DateTime?       @map("dispatch_overdue_at") @db.Timestamptz(3)
  extensionStatus     ExtensionStatus @default(NONE) @map("extension_status")
  extensionUntil      DateTime?       @map("extension_until") @db.Timestamptz(3)
  dispatchedAt        DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  deliveryReportedAt  DateTime?       @map("delivery_reported_at") @db.Timestamptz(3)
  receiptDueAt        DateTime?       @map("receipt_due_at") @db.Timestamptz(3)
  deliveredAt         DateTime?       @map("delivered_at") @db.Timestamptz(3)
  issueWindowEndsAt   DateTime?       @map("issue_window_ends_at") @db.Timestamptz(3)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  checkout Checkout     @relation(fields: [checkoutId], references: [id])
  buyer    User         @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller   User         @relation("OrderSeller", fields: [sellerId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]
  refunds  Refund[]
  disputes Dispute[]
  reviews  Review[]

  @@unique([checkoutId, sellerId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  listingId      String  @map("listing_id") @db.Uuid
  title          String
  unitPricePaise Int     @map("unit_price_paise")
  quantity       Int
  // For pickup: the item's exact pin and area, shared with the buyer once paid.
  pickupLat      Float?  @map("pickup_lat")
  pickupLng      Float?  @map("pickup_lng")
  pickupLocality String? @map("pickup_locality")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@map("order_items")
}

// Append-only history of an order: every change, who made it and why.
model OrderEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorRole   String       @map("actor_role")
  action      String
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus? @map("to_status")
  reason      String?
  createdAt   DateTime     @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}

// A payment the gateway reported for a checkout or a rental booking (exactly one).
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  checkoutId       String?       @map("checkout_id") @db.Uuid
  bookingId        String?       @map("booking_id") @db.Uuid
  gatewayOrderId   String        @map("gateway_order_id")
  gatewayPaymentId String        @unique @map("gateway_payment_id")
  amountPaise      Int           @map("amount_paise")
  status           PaymentStatus
  method           String?
  feePaise         Int?          @map("fee_paise")
  createdAt        DateTime      @map("created_at") @db.Timestamptz(3)
  capturedAt       DateTime?     @map("captured_at") @db.Timestamptz(3)

  checkout Checkout?      @relation(fields: [checkoutId], references: [id])
  booking  RentalBooking? @relation(fields: [bookingId], references: [id])
  refunds  Refund[]

  @@index([checkoutId])
  @@index([bookingId])
  @@map("payments")
}

// Every webhook received, once per gateway event id. Append-only.
model PaymentEvent {
  id             String    @id @default(uuid()) @db.Uuid
  gatewayEventId String    @unique @map("gateway_event_id")
  type           String
  payload        Json
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  @@map("payment_events")
}

// A refund of (part of) a payment. `key` makes each refund happen at most once.
model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  key                String       @unique
  checkoutId         String?      @map("checkout_id") @db.Uuid
  orderId            String?      @map("order_id") @db.Uuid
  bookingId          String?      @map("booking_id") @db.Uuid
  paymentId          String       @map("payment_id") @db.Uuid
  amountPaise        Int          @map("amount_paise")
  // The part of the amount that was for items or the rental fee (the commission base).
  itemsAmountPaise   Int          @map("items_amount_paise")
  // Rentals: the part of the amount that is the security deposit going back.
  depositAmountPaise Int          @default(0) @map("deposit_amount_paise")
  reason             RefundReason
  status             RefundStatus @default(PENDING)
  gatewayRefundId    String?      @unique @map("gateway_refund_id")
  attempts           Int          @default(0)
  lastError          String?      @map("last_error")
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)
  lastAttemptAt      DateTime?    @map("last_attempt_at") @db.Timestamptz(3)
  processedAt        DateTime?    @map("processed_at") @db.Timestamptz(3)

  checkout Checkout?      @relation(fields: [checkoutId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])
  booking  RentalBooking? @relation(fields: [bookingId], references: [id])
  payment  Payment        @relation(fields: [paymentId], references: [id])

  @@index([status, lastAttemptAt])
  @@index([bookingId])
  @@map("refunds")
}

// Append-only money record. Every row has a unique key, so the same event can
// never be written twice; the database refuses updates and deletes.
model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  entryKey    String          @unique @map("entry_key")
  type        LedgerEntryType
  amountPaise Int             @map("amount_paise")
  checkoutId  String?         @map("checkout_id") @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  bookingId   String?         @map("booking_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  refundId    String?         @map("refund_id") @db.Uuid
  sellerId    String?         @map("seller_id") @db.Uuid
  createdAt   DateTime        @map("created_at") @db.Timestamptz(3)

  @@index([checkoutId])
  @@index([orderId])
  @@index([bookingId])
  @@index([sellerId, type])
  @@map("ledger_entries")
}

// Append-only record of every admin action, with the reason given.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String
  details    Json?
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  admin User @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Rentals
// ---------------------------------------------------------------------------

enum BookingStatus {
  REQUESTED // waiting for the owner; dates held for 24 hours
  APPROVED // waiting for the renter to pay; dates held until the payment deadline
  CONFIRMED // paid: the dates are booked
  ACTIVE // handed over to the renter
  RETURNED // back with the owner; 48-hour inspection window
  CLAIM_OPEN // the owner claimed damage; waiting for the renter
  ADMIN_REVIEW // contested, unanswered or not returned: an admin decides
  SETTLING // deductions fixed; the deposit refund is on its way
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
}

// One rental of one listing for whole days (business time zone), start and end
// inclusive. Paid bookings can never overlap: an exclusion constraint in the
// migration refuses it. Amounts are paise, copied from the listing at request time.
model RentalBooking {
  id                   String        @id @default(uuid()) @db.Uuid
  ref                  String        @unique
  listingId            String        @map("listing_id") @db.Uuid
  renterId             String        @map("renter_id") @db.Uuid
  ownerId              String        @map("owner_id") @db.Uuid
  status               BookingStatus @default(REQUESTED)
  title                String
  durationDays         Int           @map("duration_days")
  startDate            DateTime      @map("start_date") @db.Date
  endDate              DateTime      @map("end_date") @db.Date
  fulfilment           Fulfilment
  // Copy of the renter's delivery address; shown to the owner once paid.
  deliveryAddress      Json?         @map("delivery_address")
  // The exact pickup spot, copied when paid and shown to the renter from then on.
  pickupLat            Float?        @map("pickup_lat")
  pickupLng            Float?        @map("pickup_lng")
  pickupLocality       String?       @map("pickup_locality")
  feePaise             Int           @map("fee_paise")
  depositPaise         Int           @map("deposit_paise")
  deliveryChargePaise  Int           @map("delivery_charge_paise")
  totalPaise           Int           @map("total_paise")
  commissionPaise      Int           @map("commission_paise")
  ownerPayablePaise    Int           @map("owner_payable_paise")
  lateFeePerDayPaise   Int           @map("late_fee_per_day_paise")
  // Running totals of processed refunds: fee and delivery, the fee part, the deposit.
  refundedPaise        Int           @default(0) @map("refunded_paise")
  feeRefundedPaise     Int           @default(0) @map("fee_refunded_paise")
  depositRefundedPaise Int           @default(0) @map("deposit_refunded_paise")
  // Worked out at return (late fee) and fixed at settlement, with what came out of
  // the deposit and anything beyond it (I12).
  lateFeePaise         Int?          @map("late_fee_paise")
  damagePaise          Int?          @map("damage_paise")
  depositDeductedPaise Int           @default(0) @map("deposit_deducted_paise")
  owedPaise            Int           @default(0) @map("owed_paise")
  holdExpiresAt        DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  approvedAt           DateTime?     @map("approved_at") @db.Timestamptz(3)
  paymentDueAt         DateTime?     @map("payment_due_at") @db.Timestamptz(3)
  gatewayOrderId       String?       @unique @map("gateway_order_id")
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(3)
  // One-time codes: the renter shows the handover code, the owner shows the return code.
  handoverCode         String?       @map("handover_code")
  handoverAttempts     Int           @default(0) @map("handover_attempts")
  returnCode           String?       @map("return_code")
  returnAttempts       Int           @default(0) @map("return_attempts")
  returnDueAt          DateTime      @map("return_due_at") @db.Timestamptz(3)
  handedOverAt         DateTime?     @map("handed_over_at") @db.Timestamptz(3)
  handoverPhotos       Json?         @map("handover_photos")
  returnedAt           DateTime?     @map("returned_at") @db.Timestamptz(3)
  returnPhotos         Json?         @map("return_photos")
  inspectionEndsAt     DateTime?     @map("inspection_ends_at") @db.Timestamptz(3)
  lateFeeDisputedAt    DateTime?     @map("late_fee_disputed_at") @db.Timestamptz(3)
  nonReturnReportedAt  DateTime?     @map("non_return_reported_at") @db.Timestamptz(3)
  remindedBeforeAt     DateTime?     @map("reminded_before_at") @db.Timestamptz(3)
  remindedDueDayAt     DateTime?     @map("reminded_due_day_at") @db.Timestamptz(3)
  overdueNotifiedAt    DateTime?     @map("overdue_notified_at") @db.Timestamptz(3)
  settledAt            DateTime?     @map("settled_at") @db.Timestamptz(3)
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing  Listing         @relation(fields: [listingId], references: [id])
  renter   User            @relation("BookingRenter", fields: [renterId], references: [id])
  owner    User            @relation("BookingOwner", fields: [ownerId], references: [id])
  hold     RentalDateHold?
  disputes Dispute[]
  reviews  Review[]
  events   BookingEvent[]
  payments Payment[]
  refunds  Refund[]

  @@index([listingId, status])
  @@index([renterId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status])
  @@map("rental_bookings")
}

// The dates a pending request keeps for itself (24 hours, then until the payment
// deadline). Separate from bookings: a hold is released when the request is paid,
// declined, cancelled or expires. Unreleased holds cannot overlap (exclusion constraint).
model RentalDateHold {
  id         String    @id @default(uuid()) @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  bookingId  String    @unique @map("booking_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)

  listing Listing       @relation(fields: [listingId], references: [id])
  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([listingId, releasedAt])
  @@map("rental_date_holds")
}

// Days the owner has closed for renting.
model RentalBlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, endDate])
  @@map("rental_blocked_dates")
}

// Append-only history of a booking: every change, who made it and why.
model BookingEvent {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorRole   String         @map("actor_role")
  action      String
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus? @map("to_status")
  reason      String?
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?         @relation(fields: [actorUserId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ---------------------------------------------------------------------------
// Messaging and offers
// ---------------------------------------------------------------------------

enum MessageKind {
  TEXT
  PHOTO
  OFFER
  SYSTEM
}

enum OfferStatus {
  OPEN // waiting for the other side
  ACCEPTED // agreed; the buyer can check out at this price until useBy
  REJECTED
  COUNTERED // replaced by a counter-offer
  WITHDRAWN
  EXPIRED
  USED // paid for in a checkout
}

// One conversation per pair of people (SPEC Module 8). The two ids are stored in a
// fixed order (a CHECK keeps user_a_id < user_b_id) so the pair is unique.
model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  userAId       String   @map("user_a_id") @db.Uuid
  userBId       String   @map("user_b_id") @db.Uuid
  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  userA        User                      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB        User                      @relation("ConversationUserB", fields: [userBId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  offers       PriceOffer[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

// Each person's place in a conversation: how far they have received and read.
// Delivered and read ticks come from these marks (message sequence numbers).
model ConversationParticipant {
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  deliveredUpTo  Int    @default(0) @map("delivered_up_to")
  readUpTo       Int    @default(0) @map("read_up_to")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

// A message is never edited. `seq` orders messages across the whole table.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  seq            Int         @unique @default(autoincrement())
  conversationId String      @map("conversation_id") @db.Uuid
  // Null for system lines ("Offer accepted").
  senderId       String?     @map("sender_id") @db.Uuid
  kind           MessageKind
  body           String?
  // What the message is about, if anything.
  listingId      String?     @map("listing_id") @db.Uuid
  orderId        String?     @map("order_id") @db.Uuid
  bookingId      String?     @map("booking_id") @db.Uuid
  offerId        String?     @map("offer_id") @db.Uuid
  createdAt      DateTime    @map("created_at") @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderId], references: [id])
  offer        PriceOffer?         @relation(fields: [offerId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId, seq])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  url       String
  storageId String   @map("storage_id")
  position  Int
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@map("message_attachments")
}

// A price offer on a sale listing. A counter-offer is a new row pointing at the one
// it replaces, so the whole history is kept. A partial unique index allows one live
// (open or accepted) offer per buyer and listing.
model PriceOffer {
  id              String      @id @default(uuid()) @db.Uuid
  listingId       String      @map("listing_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  // Who proposed this price: the buyer, or the seller in a counter-offer.
  madeById        String      @map("made_by_id") @db.Uuid
  previousOfferId String?     @unique @map("previous_offer_id") @db.Uuid
  quantity        Int
  unitPricePaise  Int         @map("unit_price_paise")
  listPricePaise  Int         @map("list_price_paise")
  status          OfferStatus @default(OPEN)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(3)
  respondedAt     DateTime?   @map("responded_at") @db.Timestamptz(3)
  acceptedAt      DateTime?   @map("accepted_at") @db.Timestamptz(3)
  useBy           DateTime?   @map("use_by") @db.Timestamptz(3)
  usedAt          DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime    @map("created_at") @db.Timestamptz(3)

  listing       Listing        @relation(fields: [listingId], references: [id])
  buyer         User           @relation("OfferBuyer", fields: [buyerId], references: [id])
  seller        User           @relation("OfferSeller", fields: [sellerId], references: [id])
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  previous      PriceOffer?    @relation("OfferChain", fields: [previousOfferId], references: [id])
  next          PriceOffer?    @relation("OfferChain")
  messages      Message[]
  checkoutItems CheckoutItem[]

  @@index([buyerId, listingId, status])
  @@index([status, expiresAt])
  @@map("price_offers")
}

// One person has blocked another. Either direction stops messages and offers (I75).
model BlockedUser {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

// ---------------------------------------------------------------------------
// Disputes, reviews and reports
// ---------------------------------------------------------------------------

enum DisputeKind {
  SALE_ISSUE // the item is wrong, damaged or not as described (7-day window)
  NOT_DELIVERED // the buyer says it never arrived, or did not answer for 48 hours
  RENTAL_DEPOSIT // damage claimed by the owner and/or a late fee disputed by the renter
  NOT_RETURNED // the owner says the rented item has not come back
}

enum DisputeStatus {
  OPEN // the other side has 48 hours to answer
  UNDER_REVIEW // an admin decides
  DECIDED // decided; 3-day appeal window, then it takes effect
  APPEALED // the appeal waits for an admin; that decision is final
  RESOLVED // the other side agreed; took effect at once
  CLOSED // the decision took effect
  WITHDRAWN // the opener withdrew it
}

// One dispute about one order or one rental booking (I79). The claimant is the side
// asking for something (the buyer or the owner, or the renter disputing a late fee);
// the respondent answers. Decisions and appeals are kept on the row; evidence in
// dispute_evidence. A partial unique index allows one unfinished dispute per order
// or booking.
model Dispute {
  id                 String        @id @default(uuid()) @db.Uuid
  ref                String        @unique
  kind               DisputeKind
  status             DisputeStatus @default(OPEN)
  orderId            String?       @map("order_id") @db.Uuid
  bookingId          String?       @map("booking_id") @db.Uuid
  claimantId         String        @map("claimant_id") @db.Uuid
  respondentId       String        @map("respondent_id") @db.Uuid
  // False when the system opened it (the buyer did not answer for 48 hours).
  openedByClaimant   Boolean       @default(true) @map("opened_by_claimant")
  // Sale issues: WRONG_ITEM, DAMAGED or NOT_AS_DESCRIBED.
  category           IssueKind?
  description        String
  // Rental damage: [{ label, amountPaise }] and their total.
  claimItems         Json?         @map("claim_items")
  claimedDamagePaise Int?          @map("claimed_damage_paise")
  lateFeeDisputed    Boolean       @default(false) @map("late_fee_disputed")
  respondDueAt       DateTime      @map("respond_due_at") @db.Timestamptz(3)
  respondedAt        DateTime?     @map("responded_at") @db.Timestamptz(3)
  reviewDueAt        DateTime?     @map("review_due_at") @db.Timestamptz(3)
  reviewOverdueAt    DateTime?     @map("review_overdue_at") @db.Timestamptz(3)
  // { outcome, refundPaise?, damagePaise?, lateFeePaise? }
  decision           Json?
  decisionReason     String?       @map("decision_reason")
  decidedById        String?       @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?     @map("decided_at") @db.Timestamptz(3)
  appealDueAt        DateTime?     @map("appeal_due_at") @db.Timestamptz(3)
  appealedById       String?       @map("appealed_by_id") @db.Uuid
  appealReason       String?       @map("appeal_reason")
  appealedAt         DateTime?     @map("appealed_at") @db.Timestamptz(3)
  finalDecision      Json?         @map("final_decision")
  finalReason        String?       @map("final_reason")
  finalDecidedById   String?       @map("final_decided_by_id") @db.Uuid
  finalDecidedAt     DateTime?     @map("final_decided_at") @db.Timestamptz(3)
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(3)
  evidencePurgedAt   DateTime?     @map("evidence_purged_at") @db.Timestamptz(3)
  createdAt          DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order?            @relation(fields: [orderId], references: [id])
  booking    RentalBooking?    @relation(fields: [bookingId], references: [id])
  claimant   User              @relation("DisputeClaimant", fields: [claimantId], references: [id])
  respondent User              @relation("DisputeRespondent", fields: [respondentId], references: [id])
  evidence   DisputeEvidence[]

  @@index([orderId])
  @@index([bookingId])
  @@index([claimantId])
  @@index([respondentId])
  @@index([status, respondDueAt])
  @@index([status, appealDueAt])
  @@map("disputes")
}

// Something one side (or the system) put on the record: text and/or photos.
model DisputeEvidence {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  // Null for system notes.
  authorId  String?  @map("author_id") @db.Uuid
  role      String // CLAIMANT, RESPONDENT, ADMIN or SYSTEM
  text      String?
  // [{ url, storageId, takenAt }]; emptied when the evidence is purged (I84).
  photos    Json     @default("[]")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id])

  @@index([disputeId, createdAt])
  @@map("dispute_evidence")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// One review per person per completed order or rental (I86): unique on the author
// and the transaction. Ratings are 1 to 5 (CHECK in the migration).
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  authorId      String       @map("author_id") @db.Uuid
  subjectId     String       @map("subject_id") @db.Uuid
  orderId       String?      @map("order_id") @db.Uuid
  bookingId     String?      @map("booking_id") @db.Uuid
  // The author's side: BUYER, SELLER, RENTER or OWNER.
  authorRole    String       @map("author_role")
  overall       Int
  communication Int
  handover      Int
  // Not asked when a seller reviews a buyer (I87).
  condition     Int?
  text          String?
  // [{ url, storageId }]
  photos        Json         @default("[]")
  status        ReviewStatus @default(PUBLISHED)
  hiddenReason  String?      @map("hidden_reason")
  hiddenById    String?      @map("hidden_by_id") @db.Uuid
  hiddenAt      DateTime?    @map("hidden_at") @db.Timestamptz(3)
  createdAt     DateTime     @map("created_at") @db.Timestamptz(3)

  author  User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject User           @relation("ReviewSubject", fields: [subjectId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])
  booking RentalBooking? @relation(fields: [bookingId], references: [id])

  @@unique([authorId, orderId])
  @@unique([authorId, bookingId])
  @@index([subjectId, status, createdAt])
  @@map("reviews")
}

enum ReportTarget {
  USER
  LISTING
  MESSAGE
  REVIEW
}

enum ReportReason {
  PROHIBITED_ITEM
  COUNTERFEIT
  SCAM
  HARASSMENT
  INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// A report waits for an admin; reporting never removes anything by itself (I89).
// A partial unique index allows one open report per reporter and target.
model Report {
  id               String       @id @default(uuid()) @db.Uuid
  reporterId       String       @map("reporter_id") @db.Uuid
  targetType       ReportTarget @map("target_type")
  targetId         String       @map("target_id") @db.Uuid
  reason           ReportReason
  details          String?
  status           ReportStatus @default(OPEN)
  resolution       String?
  resolutionReason String?      @map("resolution_reason")
  resolvedById     String?      @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  ORDERS // critical
  RENTALS // critical
  PAYMENTS // critical
  DISPUTES // critical
  MESSAGES
  OFFERS
  REVIEWS
}

// Every notification, saved before it is shown or emailed (I91). `key` names the
// event ("booking:<id>:returnTomorrow:renter") and is unique, so an event can never
// be notified twice; the email job uses the same key as its job id (I92). A row is
// kept even when the person turned the in-app channel off (inApp false), so the key
// still guards the email.
model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  key       String               @unique
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  type      String
  critical  Boolean
  inApp     Boolean              @default(true) @map("in_app")
  title     String
  body      String
  link      String?
  data      Json?
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  emailedAt DateTime?            @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime             @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, inApp, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([readAt, createdAt])
  @@map("notifications")
}

// A person's choice for one optional category (I95). Critical categories have no
// row: they are always on (SPEC Module 9).
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  inApp     Boolean              @default(true) @map("in_app")
  email     Boolean              @default(true)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}
